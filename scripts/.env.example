# Shopify credentials for refresh_par_data.py
# Copy this file to scripts/.env and fill in the values.
# Never commit .env to git.

# Your store's myshopify domain (no https://)
SHOPIFY_STORE_DOMAIN=serve-atomic.myshopify.com

# App credentials from Dev Dashboard (replaces old static access token as of 2026)
# App: "Par Data Refresh" — scopes: read_orders, read_all_orders, write_metaobjects
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
